<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060b19">

    <!-- Centered Sanwitch Logo -->
    <ImageView
        android:id="@+id/splashIcon"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_centerInParent="true"
        android:src="@drawable/splash_icon"
        android:tint="#ffffff" />

    <!-- Bottom Footer Branding Container -->
    <LinearLayout
        android:id="@+id/splashFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Stage 1 Footer: Vaigai Valley Official Logo -->
        <LinearLayout
            android:id="@+id/stage1View"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/txtFrom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="from"
                android:textColor="#97a0b5"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/logo_vaigai"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- Stage 2 Footer: CRUD -->
        <LinearLayout
            android:id="@+id/stage2View"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Built and maintained by"
                android:textColor="#97a0b5"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="CRUD"
                android:textColor="#ffffff"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
